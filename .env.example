# =============================================================================
# Agent DA — environment template
# Copy to `.env` at the repository root and fill in what you have. The file is
# found from any working directory (`apps/api` included), so `npm run dev:all`
# picks it up.
# Everything has a working default, so the app boots with an empty file and
# degrades gracefully: no NVIDIA key -> deterministic offline planner,
# no SMTP/Twilio -> reminders are logged to the console, and reported as
# `skipped` so nothing is ever marked "sent" without being sent.
# =============================================================================

# --- Application -------------------------------------------------------------
ENVIRONMENT=local                 # local | test | staging | production
DEBUG=false
# Public origin used in user-facing email links (verification / password reset).
# In production this is the static site, not the API. The React routes those
# links point at are still to come; the API side is POST /auth/verify-email and
# POST /auth/reset-password.
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Frontend (build-time, apps/web) -----------------------------------------
# Deployment only: set VITE_API_URL on the Render static site (Vite does not
# read this repo-root file). It is baked into the bundle by `npm run build`.
# Include the API version prefix; a trailing slash is tolerated. Unset locally,
# the app calls http://localhost:8000/api/v1.
# VITE_API_URL=https://agent-da-api.onrender.com/api/v1
# Vite 8 needs Node ^20.19 || >=22.12; the blueprint pins NODE_VERSION.
# NODE_VERSION=22.12.0

# --- Database ----------------------------------------------------------------
# Local default is SQLite. Render injects a postgres:// URL automatically.
DATABASE_URL=sqlite+aiosqlite:///./agent_da.db
# DATABASE_URL=postgresql://user:password@host:5432/agent_da
DB_ECHO=false

# --- Auth --------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30
# Email verification is optional by product decision.
EMAIL_VERIFICATION_REQUIRED=false

# --- LLM (NVIDIA NIM) --------------------------------------------------------
# Leave empty to use the deterministic offline planner (development and CI).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=3

# Planning shape
PLAN_CHUNK_DAYS=7
PLAN_CHUNK_THRESHOLD_DAYS=21
MAX_REPAIR_PASSES=2
PREEXPAND_DAYS=3
MAX_TIMEFRAME_DAYS=90
MIN_TIMEFRAME_DAYS=1

# memory (local/test) | postgres (production)
CHECKPOINTER_BACKEND=memory
# false = /generate only queues a draft; a worker or test drives the graph
AGENT_AUTOSTART=true

# --- Scheduler ---------------------------------------------------------------
SCHEDULER_ENABLED=true
DISPATCH_INTERVAL_SECONDS=60
MATERIALIZE_INTERVAL_MINUTES=30
DAY_CLOSE_INTERVAL_MINUTES=30
DISPATCH_BATCH_SIZE=50
DISPATCH_MAX_ATTEMPTS=3
REMINDER_RETENTION_DAYS=90
MOTIVATION_ENABLED=true

# --- Email (any SMTP provider) ----------------------------------------------
# Resend / SendGrid / Mailgun / Postmark / Gmail app password all work.
#
# With SMTP_HOST empty, reminders are *logged, not delivered*: the console
# channel reports every send as `skipped`, so nothing is silently marked "sent".
# Check with:  python -m app.cli reminders
# Prove it:    python -m app.cli send-test
#
# `npm run dev:all` points these at a local catcher, so mail is really sent over
# SMTP and saved as .eml files under $TMPDIR/agentda-mail. Run it standalone with
#   python -m app.cli mail-catcher --port 1025 --out /tmp/agentda-mail
# which needs no credentials and no STARTTLS:
#   SMTP_HOST=127.0.0.1
#   SMTP_PORT=1025
#   SMTP_STARTTLS=false
#   SMTP_USER=
#   SMTP_PASSWORD=
#
# Example (Gmail, needs a 16-character app password — not your login password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=abcd efgh ijkl mnop
#   SMTP_FROM=Agent DA <you@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Agent DA <no-reply@example.com>
SMTP_STARTTLS=true
SMTP_SSL=false

# --- WhatsApp ----------------------------------------------------------------
# auto | twilio | meta | console
WHATSAPP_PROVIDER=auto
# With no credentials configured, `auto` falls back to the console channel and
# reminders are logged rather than sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Required by Twilio outside the 24-hour user-initiated window.
TWILIO_CONTENT_SID=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_API_VERSION=v21.0
# Send by email if a WhatsApp delivery fails.
FALLBACK_TO_EMAIL=true

# --- Internal endpoints (Render Cron safety net) ----------------------------
INTERNAL_TOKEN=change-me-please

# --- Points and streaks ------------------------------------------------------
TASK_COMPLETED_POINTS=10
DAY_COMPLETE_BONUS=25
STREAK_MILESTONE_EVERY=7
STREAK_MILESTONE_BONUS=100
AGENDA_COMPLETE_BONUS=250
PERFECT_RUN_BONUS=500
# Product decision: a missed day costs points.
MISSED_DAY_DEDUCTION=5
ALLOW_POINT_DEDUCTIONS=true

# --- Behaviour ---------------------------------------------------------------
# Product decision: overdue tasks stay missed, they are not carried forward.
ROLLOVER_OVERDUE_TASKS=false
# 0 = unlimited concurrent agendas per user.
MAX_ACTIVE_AGENDAS_PER_USER=0
TODOS_PER_DAY_MIN=3
TODOS_PER_DAY_MAX=6

# --- Rate limits -------------------------------------------------------------
SIGNUP_RATE_LIMIT_PER_MINUTE=10
GENERATE_RATE_LIMIT_PER_HOUR=5